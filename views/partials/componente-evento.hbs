<li class="linha-item">
    <time class="linha-data" datetime="{{data}}">{{dataAbreviada data}}</time>
    <span class="linha-marcador" aria-hidden="true"></span>
    <article class="linha-bloco">
        <h2>{{titulo}}</h2>
        <p class="linha-info">{{horario}} | {{local}}</p>
        <p class="linha-resumo">{{descricao}}</p>
        <a class="botao-secundario" href="/eventos/{{id}}">Detalhes de {{titulo}}</a>
    </article>
</li>
