<article class="cartao-destaque">
  <h3>{{titulo}}</h3>
  <p class="cartao-destaque__info">
    <time datetime="{{data}}">{{formatarData data}}</time> &middot; {{local}}
  </p>
  <a class="botao-secundario" href="/eventos/{{id}}">
    Ver detalhes<span class="visualmente-oculto"> de {{titulo}}</span>
  </a>
</article>
