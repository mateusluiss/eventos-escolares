<section class="apresentacao" aria-labelledby="titulo-apresentacao">
  <div class="apresentacao__texto" id="sobre">
    <p class="rotulo">Agenda da instituição</p>
    <h1 id="titulo-apresentacao">Explore eventos escolares</h1>
    <p>
      Informações organizadas para a comunidade escolar: mostras, feiras,
      palestras e apresentações culturais reunidas em uma única agenda.
    </p>
    <p>Consulte os registros e veja todos os detalhes de cada evento.</p>
    <a class="botao" href="/eventos">Acessar listagem de eventos</a>
  </div>

  <figure class="apresentacao__visual">
    <img
      src="/images/agenda-eventos.svg"
      alt="Ilustração de um calendário com datas de eventos marcadas em laranja"
      width="480"
      height="360"
    >
  </figure>
</section>

<section class="destaques" aria-labelledby="titulo-destaques">
  <h2 id="titulo-destaques">Destaques do portal</h2>

  {{#if destaques.length}}
    <div class="grade-destaques">
      {{#each destaques}}
        {{> cartao-destaque}}
      {{/each}}
    </div>
  {{else}}
    <p class="estado-vazio">Nenhum evento em destaque no momento.</p>
  {{/if}}
</section>
