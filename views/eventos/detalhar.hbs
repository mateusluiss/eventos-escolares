<nav class="trilha" aria-label="Trilha de navegação">
  <ol>
    <li><a href="/">Início</a></li>
    <li><a href="/eventos">Eventos</a></li>
    <li aria-current="page">{{evento.titulo}}</li>
  </ol>
</nav>

<div class="detalhe">
  <article class="detalhe__painel">
    <h1>{{evento.titulo}}</h1>

    <dl class="detalhe__campos">
      <div class="campo">
        <dt>Título</dt>
        <dd>{{evento.titulo}}</dd>
      </div>
      <div class="campo">
        <dt>Data</dt>
        <dd><time datetime="{{evento.data}}">{{formatarData evento.data}}</time></dd>
      </div>
      <div class="campo">
        <dt>Horário</dt>
        <dd>{{evento.horario}}</dd>
      </div>
      <div class="campo">
        <dt>Local</dt>
        <dd>{{evento.local}}</dd>
      </div>
      <div class="campo">
        <dt>Descrição</dt>
        <dd>{{evento.descricao}}</dd>
      </div>
    </dl>
  </article>

  <aside class="detalhe__lateral" aria-labelledby="titulo-lateral">
    <div class="destaque-data">
      <h2 id="titulo-lateral">Data do evento</h2>
      <p class="selo-data">
        <time datetime="{{evento.data}}">{{dataAbreviada evento.data}}</time>
      </p>
      <p>Agendado para {{formatarData evento.data}}, das {{evento.horario}}.</p>
    </div>
    <a class="botao-secundario" href="/eventos">Voltar para a lista</a>
  </aside>
</div>
